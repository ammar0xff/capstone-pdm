<?xml version='1.0' encoding='utf-8'?>
<module fritzingVersion="0.2.1223" moduleId="PDM_CAP_ELEC">
 <version>4</version>
 <author>Brendan Howell</author>
 <title>Electrolytic Capacitor</title>
 <label>C</label>
 <date>2008-11-04</date>
 <tags>
  <tag>Electrolytic</tag>
  <tag>Capacitor</tag>
  <tag>fritzing core</tag>
 </tags>
 <properties>
  <property name="family">Capacitor [unidirectional]</property>
  <property name="capacitance" showInLabel="yes">1µF</property>
  <property name="package">100 mil [THT, electrolytic]</property>
   <property name="voltage" showInLabel="yes" />
</properties>
 <taxonomy>discreteParts.capacitor.electrolytic</taxonomy>
 <description>A small electrolytic capacitor</description>
 <spice><line>C{instanceTitle} {net connector0} {net connector1} {capacitance} IC=0</line></spice>
 <views>
  <iconView>
   <layers image="icon/cap_elec_icon_electrolytic_capacitor_small_icon.svg">
    <layer layerId="icon" />
   </layers>
  </iconView>
  <breadboardView fliphorizontal="true" flipvertical="true">
   <layers image="breadboard/cap_elec_breadboard_electrolytic_capacitor_small_leg.svg">
    <layer layerId="breadboard" />
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/cap_elec_schematic_capacitor_polar.svg">
    <layer layerId="schematic" />
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/cap_elec_pcb_capacitor_elko_small_100mil.svg">
     <layer layerId="copper0" />
     <layer layerId="silkscreen" />
  <layer layerId="copper1" /></layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="-" type="male">
   <description>- side</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector0pin" legId="connector0leg" />
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector0pin" terminalId="connector0terminal" />
    </schematicView>
    <pcbView>
     <p layer="copper0" svgId="connector0pin" />
    <p layer="copper1" svgId="connector0pin" /></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="+" type="male">
   <description>+ side</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector1pin" legId="connector1leg" />
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector1pin" terminalId="connector1terminal" />
    </schematicView>
    <pcbView>
     <p layer="copper0" svgId="connector1pin" />
    <p layer="copper1" svgId="connector1pin" /></pcbView>
   </views>
  </connector>
 </connectors>
</module>