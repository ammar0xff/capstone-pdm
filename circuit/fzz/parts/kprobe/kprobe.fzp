<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0" moduleId="PDM_KPROBE">
  <version>1.0</version>
  <date>2026-10-26</date>
  <author>Ammar - capstone PDM rig</author>
  <title>K-type thermocouple probe (class 1)</title>
  <description></description>
  <tags><tag>capstone</tag><tag>predictive maintenance</tag></tags>
  <properties>
    <property name="family">K-type thermocouple probe (class 1)</property>
    <property name="Interface">3V3</property>
  </properties>
  <views>
    <breadboardView><layers image="breadboard/kprobe.svg"><layer layerId="breadboard"/></layers></breadboardView>
    <schematicView><layers image="schematic/kprobe.svg"><layer layerId="schematic"/></layers></schematicView>
    <pcbView><layers image="pcb/kprobe.svg"><layer layerId="copper1"/><layer layerId="silkscreen"/><layer layerId="copper0"/></layers></pcbView>
    <iconView><layers image="breadboard/kprobe.svg"><layer layerId="icon"/></layers></iconView>
  </views>
  <connectors>
    <connector id="connector0" type="male" name="T+">
      <description>T+</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector1" type="male" name="T-">
      <description>T-</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
      </views>
    </connector>
  </connectors>
</module>
