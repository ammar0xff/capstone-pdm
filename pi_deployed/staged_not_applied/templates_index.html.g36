2.0,-2.0,0.011756,0.000741,-2.0,-2.0,0.036609,3.415745,-2.0,-2.0,3.609305,-2.0,-2.0,2.377044,0.60847,2.149703,0.397238,-2.0,0.47027,-2.0,-2.0,0.359902,0.256378,-2.0,-2.0,2.243916,-2.0,-2.0,1.479865,0.785925,0.711719,-2.0,-2.0,1.123432,-2.0,-2.0,2.237012,2.18623,-2.0,-2.0,-2.0,0.572804,0.134106,0.247384,4.002993,-2.0,-2.0,20.878397,-2.0,-2.0,4.075756,2.599773,-2.0,-2.0,0.112315,-2.0,-2.0,3.496704,0.751318,0.548433,-2.0,-2.0,0.795093,-2.0,-2.0,0.80387,0.729515,-2.0,-2.0,0.820494,-2.0,-2.0],"l":[1,2,3,4,5,6,-1,-1,-1,-1,11,12,13,-1,-1,-1,17,18,-1,-1,21,-1,-1,24,25,26,27,-1,-1,-1,31,32,-1,-1,35,-1,-1,38,39,-1,-1,42,43,-1,-1,46,-1,-1,49,50,51,52,-1,54,-1,-1,57,58,-1,-1,61,-1,-1,64,65,66,-1,-1,69,-1,-1,72,73,-1,-1,-1,77,78,79,80,-1,-1,83,-1,-1,86,87,-1,-1,90,-1,-1,93,94,95,-1,-1,98,-1,-1,101,102,-1,-1,105,-1,-1],"r":[48,23,10,9,8,7,-1,-1,-1,-1,16,15,14,-1,-1,-1,20,19,-1,-1,22,-1,-1,37,30,29,28,-1,-1,-1,34,33,-1,-1,36,-1,-1,41,40,-1,-1,45,44,-1,-1,47,-1,-1,76,63,56,53,-1,55,-1,-1,60,59,-1,-1,62,-1,-1,71,68,67,-1,-1,70,-1,-1,75,74,-1,-1,-1,92,85,82,81,-1,-1,84,-1,-1,89,88,-1,-1,91,-1,-1,100,97,96,-1,-1,99,-1,-1,104,103,-1,-1,106,-1,-1],"v":[0.50038,0.66579,0.84626,0.62847,0.68075,0.71045,0.67554,0.73539,0.60515,0.42458,0.89544,0.97452,0.98513,0.99328,0.97806,0.93147,0.86591,0.90561,0.88063,0.95452,0.80959,0.90256,0.7001,0.61211,0.5062,0.22704,0.17632,0.13358,0.2494,0.3217,0.53406,0.71618,0.78698,0.5822,0.50307,0.56294,0.32148,0.73155,0.96176,0.97368,0.94985,0.71258,0.74281,0.64356,0.80764,0.58695,0.51219,0.80348,0.42475,0.53983,0.7894,0.83667,0.94449,0.81823,0.71128,0.84133,0.71325,0.86116,0.75622,0.93484,0.62933,0.70282,0.49965,0.48911,0.5068,0.43547,0.61579,0.37306,0.55549,0.66865,0.45146,0.18291,0.20781,0.23047,0.18284,0.08331,0.33108,0.42944,0.40187,0.51223,0.4018,0.67368,0.32884,0.24312,0.4448,0.58338,0.67934,0.39371,0.73948,0.39555,0.51435,0.23517,0.25503,0.31341,0.41808,0.31601,0.59433,0.25407,0.16385,0.3612,0.12643,0.16178,0.09456,0.18654,0.02644,0.04577,0.01728]}]};
const MINN=40,BIN_S=10,ERR=0.29;
const X={en:{t:"Remaining life (benchmark)",s:"indicative trend, not a measured life",k1:"Estimated remaining",
 wait:"Collecting data: __N__ of 40 samples.",nobase:"Needs a commissioned baseline of this machine first. The default baseline is not this motor's healthy level.",inval:"Waiting for valid readings (sensor data not valid right now).",
 range:"Typical error of this model on public bearings: about 0.3 of the whole life, so read it as a range: __LO__ to __HI__ %.",
 note:"Trained on 25 public run-to-failure bearings: XJTU-SY, NASA IMS, PRONOSTIA (vibration rms and kurtosis only). Leave-one-bearing-out: error in the last 20% of life 0.29 vs 0.40 for a constant guess, 19 of 25 bearings warned in time. NOT validated on our fan motor, and it does not give hours. A rising trend from a moved sensor or a speed change looks the same.",
 truth:"Dataset truth (replay only)",pred:"Model estimate",unit:"% of life left",older:"older",now:"now"},
 ar:{t:"العمر المتبقي (قياسي)",s:"اتجاه تقريبي، مش عمر متقاس",k1:"المتبقي تقريبا",
 wait:"بنجمع بيانات: __N__ من 40 عينة.",nobase:"محتاج خط أساس متعاير للماكينة دي الأول. الخط الافتراضي مش مستوى الموتور ده وهو سليم.",inval:"مستني قراءات صالحة (بيانات الحساس مش صالحة دلوقتي).",
 range:"متوسط خطأ النموذج على رولمان عامة: حوالي 0.3 من العمر كله، فاقرأه كنطاق: من __LO__ لـ __HI__ %.",
 note:"متدرب على 25 رولمان عامة لحد العطل: XJTU-SY وNASA IMS وPRONOSTIA (rms وkurtosis بس). اختبار بترك رولمان واحد بره: خطأ آخر 20% من العمر 0.29 مقابل 0.40 لتخمين ثابت، و19 من 25 رولمان اتحذروا في الوقت. مش مثبت على موتور مروحتنا ومبيدّيش ساعات. ارتفاع بسبب حساس اتحرك أو تغير سرعة شكله زي بعضه.",
 truth:"الحقيقة من الداتا (إعادة التشغيل بس)",pred:"تقدير النموذج",unit:"% من العمر متبقي",older:"أقدم",now:"دلوقتي"}};
const lang=()=>(typeof isAr!=="undefined"&&isAr)?"ar":"en";
const $=id=>document.getElementById(id);
function walk(t,x){let i=0;while(t.l[i]!==-1)i=x[t.f[i]]<=t.t[i]?t.l[i]:t.r[i];return t.v[i]}
function predict(f){let s=0;for(const t of MODEL.trees)s+=walk(t,f);return Math.min(1,Math.max(0,s/MODEL.trees.length))}
const med=a=>{const b=a.slice().sort((x,y)=>x-y),m=b.length>>1;return b.length%2?b[m]:(b[m-1]+b[m])/2};
function slope(a){if(a.length<5)return 0;const n=a.length;let sx=0,sy=0,sxy=0,sxx=0;for(let i=0;i<n;i++){sx+=i;sy+=a[i];sxy+=i*a[i];sxx+=i*i}return(n*sxy-sx*sy)/(n*sxx-sx*sx)}
function feats(nn,kk,sm,mx){const i=nn.length-1;const s=med(nn.slice(-20));sm.push(s);mx=Math.max(mx,s);const sl=slope(sm.slice(-40))*40;const km=kk.slice(-20).reduce((a,b)=>a+b,0)/Math.min(20,kk.length);return{f:[s,sl,km,mx,nn[i]],mx:mx}}
let st=null,raw=[],series=[],base=null,ref=null,msg="wait",nsamp=0,binT=0,binV=[],binK=[];
function reset(){st={nn:[],kk:[],sm:[],mx:-1e9};series=[];raw=[];nsamp=0;binV=[];binK=[]}
reset();
function sample(mu,rms,kurt,truth){st.nn.push(Math.log(rms/mu));st.kk.push(kurt);const r=feats(st.nn,st.kk,st.sm,st.mx);st.mx=r.mx;nsamp=st.nn.length;
 if(nsamp>=MINN){raw.push(predict(r.f));series.push({p:med(raw.slice(-9)),t:truth})}}
function add(d){
 try{if(!d||!d.vibration)return;const v=d.vibration,rd=d.reference_data;const mu=d.spc&&d.spc.baseline_mu,src=d.spc&&d.spc.baseline_source;
 if(!(mu>0)){msg="nobase";return}
 if(!rd&&src!=="commissioned"){msg="nobase";if(base!==null){reset()}base=null;return}
 if(base!==mu){base=mu;reset()}
 const rms=v.rms_dyn,k=v.kurtosis;
 const ok=d.input_valid!==false&&d.state!=="Unknown"&&isFinite(rms)&&rms>0&&rms<16&&isFinite(k)&&k>0&&k<30&&(v.fs_hz===undefined||v.fs_hz>=300);
 if(!ok){msg="inval";return}
 msg="ok";const truth=rd&&rd.snapshots_total?1-rd.snapshot/(rd.snapshots_total-1):null;
 if(rd){if(ref!==d.seq){ref=d.seq;sample(mu,rms,k,truth)}}
 else{const now=Date.now()/1000;if(!binT)binT=now;binV.push(rms);binK.push(k);if(now-binT>=BIN_S){sample(mu,med(binV),binK.reduce((a,b)=>a+b,0)/binK.length,null);binV=[];binK=[];binT=now}}
 }catch(e){console.error(e)}}
function render(){const T=X[lang()];$("bm-t").innerText=T.t;$("bm-s").innerText=T.s;$("bm-k1").innerText=T.k1;$("bm-note").innerText=T.note;
 const n=series.length,last=n?series[n-1].p:null;
 if(msg==="nobase"&&!last){$("bm-v").innerText="n/a";$("bm-st").innerText=T.nobase;$("bm-ch").innerHTML="";return}
 if(msg==="inval"&&!last){$("bm-v").innerText="n/a";$("bm-st").innerText=T.inval;$("bm-ch").innerHTML="";return}
 if(last===null){$("bm-v").innerText="n/a";$("bm-st").innerText=T.wait.replace("__N__",Math.min(nsamp,MINN));$("bm-ch").innerHTML="";return}
 $("bm-v").innerText="about "+Math.round(last*100)+" %";if(lang()==="ar")$("bm-v").innerText="حوالي "+Math.round(last*100)+" %";
 $("bm-st").innerText=T.range.replace("__LO__",Math.round(Math.max(0,last-ERR)*100)).replace("__HI__",Math.round(Math.min(1,last+ERR)*100));
 const w=1180,h=190,Y=v=>160-v*140,Xp=i=>50+i/Math.max(1,n-1)*1110;let s="";
 for(const v of[0,0.5,1])s+='<line x1="50" x2="1160" y1="'+Y(v)+'" y2="'+Y(v)+'" stroke="#223041"/><text x="4" y="'+(Y(v)+4)+'" fill="#6f819a" font-size="11">'+Math.round(v*100)+'</text>';
 if(n>1){let up="",dn="";series.forEach((q,i)=>{up+=(i?"L":"M")+Xp(i)+","+Y(Math.min(1,q.p+ERR))});for(let i=n-1;i>=0;i--)dn+="L"+Xp(i)+","+Y(Math.max(0,series[i].p-ERR));
  s+='<path d="'+series.map((q,i)=>(i?"L":"M")+Xp(i)+","+Y(Math.min(1,q.p+ERR))).join("")+'" fill="none" stroke="#4c9eff" stroke-width="1" opacity=".35" stroke-dasharray="3,4"/><path d="'+series.map((q,i)=>(i?"L":"M")+Xp(i)+","+Y(Math.max(0,q.p-ERR))).join("")+'" fill="none" stroke="#4c9eff" stroke-width="1" opacity=".35" stroke-dasharray="3,4"/><path d="'+series.map((q,i)=>(i?"L":"M")+Xp(i)+","+Y(q.p)).join("")+'" fill="none" stroke="#4c9eff" stroke-width="2.2"/>';
  if(series.some(q=>q.t!==null))s+='<path d="'+series.map((q,i)=>(i?"L":"M")+Xp(i)+","+Y(q.t===null?0:q.t)).join("")+'" fill="none" stroke="#8b9bb0" stroke-width="1.6" stroke-dasharray="6,4"/>'}
 s+='<text x="50" y="184" fill="#6f819a" font-size="11">'+T.older+'</text><text x="1160" y="184" text-anchor="end" fill="#6f819a" font-size="11">'+T.now+'</text><text x="1160" y="14" text-anchor="end" fill="#4c9eff" font-size="11">'+T.pred+' ('+T.unit+')</text>'+(series.some(q=>q.t!==null)?'<text x="1160" y="28" text-anchor="end" fill="#8b9bb0" font-size="11">'+T.truth+'</text>':'');
 $("bm-ch").innerHTML='<svg viewBox="0 0 '+w+' '+h+'" width="100%" style="direction:ltr;display:block">'+s+'</svg>'}
return{add:add,render:render,reset:reset,predict:predict,feats:feats,_n:function(){return series.length},_ns:function(){return nsamp},_msg:function(){return msg}};
})();
(function(){const o=onData;onData=function(d){try{BM.add(d)}catch(e){}return o.apply(this,arguments)};const t=toggleLang;toggleLang=function(){const r=t.apply(this,arguments);try{BM.render()}catch(e){}return r};setInterval(function(){try{BM.render()}catch(e){}},1000);BM.render()})();
</script>
</body></html>
