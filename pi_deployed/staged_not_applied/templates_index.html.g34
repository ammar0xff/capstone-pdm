const Exp=(function(){
const W=60,TH=88,R="#ef5b5b",B="#4c9eff",G="#8b9bb0";
const X={en:{x_title:"Speech filter experiment",x_sub:"display only, does not change state or Warnings",x_h1:"Live sound level, last 60 s",x_h2:"Audio Warning strips (red = without filter, blue = with filter, grey = speech detected)",x_l1:"Raw level the audio rule sees",x_l2:"After the filter (speech-like chunks removed)",x_l3:"Warning threshold 88 dB",x_h3:"Recorded data (Nov 25, this Pi, run through the deployed audio code)",pause:"Pause",resume:"Resume",clear:"Clear",wait:"Live: waiting for the microphone",live:"Live",share:"Share of time in Warning (this view)",raw:"without filter",aft:"with filter",bars:"Share of chunks that raise the audio Warning",spec:"Average spectrum (dB, relative), speech band 300-3400 Hz shaded",tl:"Level over time (max per 0.5 s)",hz:"Hz",s:"s",now:"now",
 takes:["Motor off, no speech (23:07)","Motor running, no speech (23:15)","Motor running + people talking (23:28)"],
 note:"Honest limits: three 60 s recordings, one speech sample, unknown speaker and distance. The filter only decides whether the loud-level audio Warning may fire. It does not clean the audio, and it cannot tell speech from music, a TV or other loud sound in 300-3400 Hz. While speech is detected the blue line is held at the last non-speech level, and is blank if there was none (the first second of each recording is skipped). The vibration gate never uses audio. The 23:07 take is labelled motor off from the user's statement."},
ar:{x_title:"تجربة فلتر الكلام",x_sub:"للعرض فقط ومبتغيرش الحالة ولا التحذيرات",x_h1:"مستوى الصوت المباشر، آخر 60 ثانية",x_h2:"شرائط تحذير الصوت (أحمر = من غير فلتر، أزرق = بالفلتر، رمادي = كلام)",x_l1:"المستوى الخام اللي قاعدة الصوت بتشوفه",x_l2:"بعد الفلتر (شيل أجزاء الكلام)",x_l3:"حد التحذير 88 ديسيبل",x_h3:"بيانات مسجلة (25 نوفمبر، على الباي ده، بنفس كود الصوت المركب)",pause:"إيقاف",resume:"كمل",clear:"مسح",wait:"مباشر: مستني الميكروفون",live:"مباشر",share:"نسبة الوقت في تحذير (العرض ده)",raw:"من غير فلتر",aft:"بالفلتر",bars:"نسبة اللقطات اللي بتطلع تحذير صوت",spec:"متوسط الطيف (ديسيبل نسبي)، نطاق الكلام 300-3400 هرتز مظلل",tl:"المستوى مع الوقت (أعلى قيمة كل نص ثانية)",hz:"هرتز",s:"ث",now:"دلوقتي",
 takes:["الموتور مطفي، من غير كلام (23:07)","الموتور شغال، من غير كلام (23:15)","الموتور شغال + ناس بتتكلم (23:28)"],
 note:"حدود لازم تتقال: تلات تسجيلات مدة كل واحد 60 ثانية، وعينة كلام واحدة، والمتكلم والمسافة مجهولين. الفلتر بس بيقرر هل تحذير مستوى الصوت العالي يشتغل ولا لأ. مبينضفش الصوت، ومبيفرقش بين الكلام والموسيقى أو التلفزيون أو أي صوت عالي في 300-3400 هرتز. وقت الكلام الخط الأزرق بيثبت على آخر مستوى من غير كلام، وبيبقى فاضي لو مفيش (أول ثانية من كل تسجيل متشالة). اهتزاز الموتور مبيستخدمش الصوت. تسجيل 23:07 معنون موتور مطفي حسب كلام المستخدم."}};
let pts=[],paused=false,lastNS=null,lastT=0;
const lang=()=>(typeof isAr!=="undefined"&&isAr)?"ar":"en";
const $=id=>document.getElementById(id);
function svg(w,h,body){return '<svg viewBox="0 0 '+w+' '+h+'" width="100%" style="display:block">'+body+'</svg>'}
const ax=(x,y,t,a)=>'<text x="'+x+'" y="'+y+'" fill="#6f819a" font-size="11"'+(a?' text-anchor="'+a+'"':'')+'>'+t+'</text>';
function path(a,fx,fy){let s="",pen=false;a.forEach((p,i)=>{if(p===null||p===undefined){pen=false;return}s+=(pen?"L":"M")+fx(p,i).toFixed(1)+","+fy(p,i).toFixed(1);pen=true});return s}
function add(d){
 if(paused||!d||!d.acoustic)return;const a=d.acoustic;if(typeof a.db_spl!=="number")return;
 const now=Date.now()/1000;if(now-lastT<0.25)return;lastT=now;
 const sp=!!a.speech_like,db=a.db_spl,zc=a.zcr||0,rw=(db>TH)||(zc>0.28);
 if(!sp)lastNS=db;
 pts.push({t:now,raw:db,aft:sp?lastNS:db,sp:sp,rw:rw,aw:rw&&!sp});
 const cut=now-W;while(pts.length&&pts[0].t<cut)pts.shift();
}
function renderLive(){
 const T=X[lang()],n=pts.length;
 $("x-live").innerText=paused?"||":(n?T.live+": "+(pts[n-1].sp?"speech detected":"no speech detected"):T.wait);
 if(lang()==="ar"&&n&&!paused)$("x-live").innerText=T.live+": "+(pts[n-1].sp?"كلام مكتشف":"مفيش كلام");
 const w=1180,h=230,lo=50,hi=120,Y=v=>205-(Math.min(hi,Math.max(lo,v))-lo)/(hi-lo)*185;
 const t1=n?pts[n-1].t:Date.now()/1000,X0=p=>50+(p.t-(t1-W))/W*1120;
 let s="";for(let v=60;v<=120;v+=20)s+='<line x1="50" x2="1170" y1="'+Y(v)+'" y2="'+Y(v)+'" stroke="#223041"/>'+ax(4,Y(v)+4,v);
 s+='<line x1="50" x2="1170" y1="'+Y(TH)+'" y2="'+Y(TH)+'" stroke="#f0b429" stroke-dasharray="6,4"/>';
 if(n>1){s+='<path d="'+path(pts,X0,p=>Y(p.raw))+'" fill="none" stroke="'+R+'" stroke-width="2"/><path d="'+path(pts,X0,p=>Y(p.aft))+'" fill="none" stroke="'+B+'" stroke-width="2"/>'}
 s+=ax(50,224,"-60 "+T.s)+ax(1170,224,T.now,"end");$("x-live-db").innerHTML=svg(w,h,s);
 let t="";const bw=Math.max(3,1120/W*0.3);pts.forEach(p=>{const x=X0(p);if(p.sp)t+='<rect x="'+x.toFixed(1)+'" y="2" width="'+bw+'" height="66" fill="'+G+'" opacity=".2"/>';if(p.rw)t+='<rect x="'+x.toFixed(1)+'" y="10" width="'+bw+'" height="20" fill="'+R+'"/>';if(p.aw)t+='<rect x="'+x.toFixed(1)+'" y="40" width="'+bw+'" height="20" fill="'+B+'"/>'});
 $("x-live-strip").innerHTML=svg(w,70,t);
 const pr=n?pts.filter(p=>p.rw).length/n*100:0,pa=n?pts.filter(p=>p.aw).length/n*100:0;
 $("x-live-share").innerHTML=svg(w,64,ax(50,12,T.share)+'<rect x="50" y="18" width="'+Math.max(2,pr*9)+'" height="16" fill="'+R+'"/>'+ax(58+pr*9,31,pr.toFixed(1)+"% "+T.raw)+'<rect x="50" y="40" width="'+Math.max(2,pa*9)+'" height="16" fill="'+B+'"/>'+ax(58+pa*9,53,pa.toFixed(1)+"% "+T.aft));
}
function renderStatic(){
 const T=X[lang()],tk=EVID.takes;let o="";
 // bars
 let b='<text x="4" y="12" fill="#8b9bb0" font-size="12">'+T.bars+'</text>';const by=v=>200-v*100*5.2;
 for(let v=0;v<=30;v+=10)b+='<line x1="40" x2="1170" y1="'+(200-v*5.2)+'" y2="'+(200-v*5.2)+'" stroke="#223041"/>'+ax(4,204-v*5.2,v+"%");
 tk.forEach((k,i)=>{const x=80+i*370,hr=k.raw_share*100*5.2,ha=k.after_share*100*5.2;
  b+='<rect x="'+x+'" y="'+(200-hr)+'" width="90" height="'+hr+'" fill="'+R+'"/>'+ax(x+45,194-hr,(k.raw_share*100).toFixed(1)+"%","middle")+'<rect x="'+(x+100)+'" y="'+(200-Math.max(ha,1))+'" width="90" height="'+Math.max(ha,1)+'" fill="'+B+'"/>'+ax(x+145,194-ha,(k.after_share*100).toFixed(1)+"%","middle")+ax(x+95,222,T.takes[i],"middle")});
 o+=svg(1180,232,b);
 // spectrum with y axis
 const cols=["#7a8aa0","#c8a2ff","#ef5b5b"];let all=[];tk.forEach(k=>all=all.concat(k.spec_db));const mn=Math.floor(Math.min.apply(null,all)/10)*10,mx=Math.ceil(Math.max.apply(null,all)/10)*10;
 const sy=v=>180-(v-mn)/(mx-mn)*160,sx=f=>60+f/4000*1100;
 let s='<text x="4" y="12" fill="#8b9bb0" font-size="12">'+T.spec+'</text><rect x="'+sx(300)+'" y="20" width="'+(sx(3400)-sx(300))+'" height="160" fill="#8b9bb0" opacity=".12"/>';
 for(let v=mn;v<=mx;v+=10)s+='<line x1="60" x2="1160" y1="'+sy(v)+'" y2="'+sy(v)+'" stroke="#223041"/>'+ax(36,sy(v)+4,v,"end");
 for(let f=0;f<=4000;f+=500)s+=ax(sx(f),196,f,"middle");s+=ax(1160,210,T.hz,"end");
 tk.forEach((k,i)=>{s+='<path d="'+path(k.spec_db,(v,j)=>sx(j*100+50),v=>sy(v))+'" fill="none" stroke="'+cols[i]+'" stroke-width="2"/>'});
 o+=svg(1180,214,s)+'<div class="leg">'+tk.map((k,i)=>'<span style="--c:'+cols[i]+'">'+T.takes[i]+'</span>').join("")+'</div>';
 // timelines
 tk.forEach((k,i)=>{const n=k.db_bins.length,X1=j=>50+j/n*1120,Y=v=>150-(Math.min(115,Math.max(55,v))-55)/60*130;let last=null,aft=k.db_bins.map((v,j)=>{if(j<2)return null;if(!k.speech_bins[j])last=v;return k.speech_bins[j]?last:v});
  let t='<text x="4" y="12" fill="#8b9bb0" font-size="12">'+T.takes[i]+" - "+T.tl+'</text>';
  for(let v=60;v<=110;v+=10)t+='<line x1="50" x2="1170" y1="'+Y(v)+'" y2="'+Y(v)+'" stroke="#223041"/>'+ax(4,Y(v)+4,v);
  k.speech_bins.forEach((s2,j)=>{if(s2)t+='<rect x="'+X1(j)+'" y="20" width="'+(1120/n+.5)+'" height="130" fill="#8b9bb0" opacity=".2"/>'});
  t+='<line x1="50" x2="1170" y1="'+Y(88)+'" y2="'+Y(88)+'" stroke="#f0b429" stroke-dasharray="6,4"/><path d="'+path(k.db_bins,(v,j)=>X1(j),v=>Y(v))+'" fill="none" stroke="'+R+'" stroke-width="1.6"/><path d="'+path(aft,(v,j)=>X1(j),v=>Y(v))+'" fill="none" stroke="'+B+'" stroke-width="1.6"/>';
  k.raw_warn_bins.forEach((w2,j)=>{if(w2)t+='<rect x="'+X1(j)+'" y="160" width="'+(1120/n+.5)+'" height="8" fill="'+R+'"/>'});
  k.after_warn_bins.forEach((w2,j)=>{if(w2)t+='<rect x="'+X1(j)+'" y="172" width="'+(1120/n+.5)+'" height="8" fill="'+B+'"/>'});
  t+=ax(50,194,"0 "+T.s)+ax(1170,194,"60 "+T.s,"end");o+=svg(1180,200,t)});
 $("x-static").innerHTML=o;$("x-note").innerText=T.note;
}
function labels(){const T=X[lang()];for(const k of["x_title","x_sub","x_h1","x_h2","x_l1","x_l2","x_l3","x_h3"]){const e=$(k.replace("_","-"));if(e)e.innerText=T[k]}$("x-pause").innerText=paused?T.resume:T.pause;$("x-clear").innerText=T.clear}
function render(){labels();renderLive();renderStatic()}
return{add:add,pause:function(){paused=!paused;render()},clear:function(){pts=[];lastNS=null;renderLive()},render:render,renderLive:renderLive,_pts:function(){return pts}};
})();
(function(){const o=onData;onData=function(d){try{Exp.add(d)}catch(e){}return o.apply(this,arguments)};const t=toggleLang;toggleLang=function(){const r=t.apply(this,arguments);try{Exp.render()}catch(e){}return r};
try{Exp.render()}catch(e){console.error(e)}setInterval(function(){try{Exp.renderLive()}catch(e){}},1000)})();
</script>
</body></html>
